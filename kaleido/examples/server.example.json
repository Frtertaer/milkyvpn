{
  "schema": "kaleido.runtime/v1",
  "role": "server",
  "listen": {
    "host": "0.0.0.0",
    "port": 443
  },
  "tls": {
    "certificate_file": "server-cert.pem",
    "private_key_file": "server-tls-private.pem"
  },
  "protocol": {
    "mode": "kal1",
    "psk_file": "kaleido.psk",
    "server_identity_private_file": "server-identity-private.pem"
  },
  "target_policy": {
    "allow_public": true,
    "allow_hosts": [],
    "allow_ports": [80, 443],
    "deny_loopback": true,
    "deny_private": true,
    "deny_link_local": true,
    "deny_multicast": true,
    "deny_reserved": true
  },
  "decoy": {
    "status": 200,
    "server": "nginx"
  },
  "limits": {
    "outer_sessions": 256,
    "socks_sessions": 128
  }
}
